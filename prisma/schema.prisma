generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Patient {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  birthDate DateTime
  createdAt DateTime @default(now())

   consultations  Consultation[]  // ✅ Relation inverse
}

model Consultation {
  id             String   @id @default(cuid())
  date           DateTime
  notes          String
  diagnostic     String?   // 👈 nouveau champ
  observations   String?   // 👈 nouveau champ
  recommandation String?   // 👈 nouveau champ

  patient        Patient  @relation(fields: [patientId], references: [id])
  patientId      String
}
